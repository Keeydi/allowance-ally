# Frontend (Vite) - copy to .env
# Local dev: use localhost. Production (Vercel): MUST set in Vercel → Settings → Environment Variables, then redeploy.
# If unset in production, app uses https://allowance-ally-production.up.railway.app/api
VITE_API_URL=http://localhost:3000/api
# Production (set this in Vercel env vars and redeploy to fix CORS / "backend not detected"):
# VITE_API_URL=https://allowance-ally-production.up.railway.app/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
