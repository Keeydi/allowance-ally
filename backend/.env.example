# Backend - PostgreSQL / Supabase
# Copy to .env and fill in values

# Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Or use individual vars (optional fallback):
# DB_HOST=db.xxx.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_NAME=postgres

JWT_SECRET=your-secure-random-string-32-chars-minimum
JWT_EXPIRES_IN=7d
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
PORT=3000

# Optional: comma-separated origins to allow (e.g. custom domain for Vercel frontend)
# CORS_ORIGIN=https://your-app.vercel.app,https://app.yourdomain.com
